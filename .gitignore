# The experiment's inputs and outputs are reproducible from the scripts; the repository keeps the
# evidence (results.json, the report, the README) and not the bulk.
build/dumps/
# Run state, rewritten by every partial run and clobbered by any `--only`. The evidence a reader
# needs — row counts, index parity, statement errors, timings — is folded into results.json.
build/progress.json
data/
.venv/
__pycache__/
.env
# a full --restart moves the previous results aside rather than deleting them
build/results.json.superseded
build/img-preview/
# the schema preflight scratch area, written as root by the Dolt container
build/preflight/
build/trace/
# the DoltLite packages scripts/lite_image.py downloads and checks, and the night-run drivers and their logs
build/doltlite/
build/run-*
build/stack-*.log
build/preflight-*.log
# the kernel lock every measuring or cleaning script takes (scripts/common.py run_lock); it names its holder
build/run.lock
# generated by scripts/stack_config.py on every make up
compose.override.yaml
# the Workbench's saved connections, written by scripts/stack_config.py on every make up
docker/workbench/store/
# what the stack serves, written by scripts/stack_config.py
build/serve.json
