# The experiment's inputs and outputs are reproducible from the scripts; the repository keeps the
# evidence (results.json, the report, the README) and not the bulk.
build/dumps/
# Run state, rewritten by every partial run and clobbered by any `--only`. The evidence a reader
# needs — row counts, index parity, statement errors, timings — is folded into results.json.
build/progress.json
data/
.venv/
__pycache__/
.env
# a full --restart moves the previous results aside rather than deleting them
build/results.json.superseded
build/img-preview/
# the schema preflight scratch area, written as root by the Dolt container
build/preflight/
